# Backend Configuration - My Content Recommender API
# Copiez ce fichier en .env et ajustez les valeurs selon vos besoins

# ====================================
# CHEMINS
# ====================================
DATA_PATH=data

# ====================================
# PARAMÈTRES TEMPORELS
# ====================================
# Âge maximum des articles recommandables (en jours)
MAX_ARTICLE_AGE_DAYS=730

# Nombre minimum de mots par article (filtrage qualité)
MIN_WORDS_COUNT=50

# ====================================
# PARAMÈTRES DE RECOMMANDATION
# ====================================
# Nombre de recommandations par défaut
N_RECOMMENDATIONS=5

# Nombre de clusters d'utilisateurs (K-means)
N_USER_CLUSTERS=5

# ====================================
# COLD START - UTILISATEURS
# ====================================
# Nombre minimum d'articles uniques lus pour considérer qu'un utilisateur a un historique suffisant
# Valeurs recommandées :
# - 3 : Permissif (plus de personnalisation, risque de surapprentissage)
# - 5 : Équilibré (recommandé)
# - 10 : Conservateur (plus de fallback vers popularité)
MIN_UNIQUE_ARTICLES_READ=5

# ====================================
# COLD START - NOUVEAUX ARTICLES
# ====================================
# Solution 1: Boost temporaire de nouveauté (multiplicateur de score)
# Articles < 24h reçoivent un boost de visibilité
NOVELTY_BOOST_24H=1.5

# Articles entre 24h et 72h reçoivent un boost réduit
NOVELTY_BOOST_72H=1.2

# Solution 2: Fenêtre temporelle par défaut pour l'endpoint /articles/recent (en heures)
RECENT_ARTICLES_CUTOFF_HOURS=48

# ====================================
# APPROCHE HYBRIDE - PONDÉRATIONS
# ====================================
# Ces valeurs sont utilisées pour la méthode "hybrid"
# La somme devrait être proche de 1.0 pour une normalisation cohérente
#
# HYBRID_WEIGHT_CLUSTERING : Filtrage collaboratif (utilisateurs similaires)
# HYBRID_WEIGHT_CONTENT : Similarité de contenu (embeddings)
# HYBRID_WEIGHT_POPULARITY : Tendances actuelles (popularité normalisée par âge)
# HYBRID_WEIGHT_DIVERSITY : Bonus d'exploration (nouvelles catégories)
#
# Note: Ces valeurs sont définies dans config.py comme dict.
# Pour les modifier, éditez directement config.py ou implémentez le parsing depuis .env

# ====================================
# CLUSTERING
# ====================================
# Fréquence de mise à jour des clusters utilisateurs (en heures)
CLUSTER_UPDATE_FREQUENCY_HOURS=24

# ====================================
# DATE DE RÉFÉRENCE
# ====================================
# Date de référence pour les calculs temporels (auto-détectée si non définie)
# Format: YYYY-MM-DD HH:MM:SS
# Laissez vide pour auto-détection depuis les données
# REFERENCE_DATE=2017-11-13 00:00:00

# ====================================
# API
# ====================================
# Port de l'API (utilisé par uvicorn)
API_PORT=8000

# Host (0.0.0.0 pour écouter sur toutes les interfaces)
API_HOST=0.0.0.0

# Mode debug (true/false)
DEBUG=false

# ====================================
# AZURE APP SERVICE - PRODUCTION
# ====================================
# Configuration Gunicorn pour production
GUNICORN_WORKERS=2              # Nombre de workers (2 x NUM_CORES + 1)
GUNICORN_TIMEOUT=120            # Timeout des workers (secondes)
GUNICORN_BIND=0.0.0.0:8000      # Adresse de bind
GUNICORN_LOG_LEVEL=info         # Niveau de logs: debug, info, warning, error

# CORS - Origins autorisées (séparées par des virgules)
# En production, remplacer par vos domaines réels
# Exemple: https://my-content-frontend.vercel.app,https://my-content.azurewebsites.net
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
