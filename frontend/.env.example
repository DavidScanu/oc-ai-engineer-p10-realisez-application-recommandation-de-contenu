# Frontend Configuration - My Content Recommender App
# Copiez ce fichier en .env.local et ajustez les valeurs

# ====================================
# API BACKEND
# ====================================
# URL du backend FastAPI
# Développement local : http://localhost:8000
# Production Azure : https://votre-app.azurewebsites.net
NEXT_PUBLIC_API_URL=http://localhost:8000

# ====================================
# NEXT.JS
# ====================================
# Mode de développement (true/false)
# En production, mettez à false
NODE_ENV=development

# ====================================
# DÉPLOIEMENT
# ====================================
# Ces variables sont généralement définies par la plateforme de déploiement

# Vercel
# VERCEL_URL=
# VERCEL_ENV=

# Azure Static Web Apps
# AZURE_STATIC_WEB_APPS_API_TOKEN=
